{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["turbo.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".medusa/**"]
    },
    "build:plugin": {
      "dependsOn": ["^build", "@medusajs/medusa#build"],
      "outputs": [".medusa/**"]
    },
    "test": { "outputs": [] },
    "test:integration": { "outputs": [] },
    "test:integration:chunk": { "outputs": [] }
  }
}
