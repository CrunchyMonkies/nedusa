{
  "name": "@nedusa/caching-redis",
  "version": "2.21.1",
  "description": "Redis Caching for Medusa",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medusajs/medusa.git",
    "directory": "packages/modules/providers/caching-redis"
  },
  "bugs": {
