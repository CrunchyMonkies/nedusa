{
  "name": "@nedusa/notification-local",
  "version": "2.21.1",
  "description": "Local (logging) notification provider for Medusa, useful for testing purposes and log audits",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medusajs/medusa.git",
    "directory": "packages/modules/providers/notification-local"
  },
  "bugs": {
    "url": "https://github.com/medusajs/medusa/issues"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Medusa",
  "license": "MIT",
  "scripts": {
    "test": "jest --passWithNoTests src",
    "test:integration": "jest --passWithNoTests --forceExit --testPathPattern=\"integration-tests/__tests__/.*\\.spec\\.ts\"",
    "build": "rimraf dist && tsc --build ./tsconfig.json",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@nedusa/framework": "2.21.1"
  },
  "peerDependencies": {
    "@nedusa/framework": "2.21.1"
  },
  "keywords": [
    "medusa-provider",
    "medusa-provider-local"
  ]
}
