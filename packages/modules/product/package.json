{
  "name": "@nedusa/product",
  "version": "2.21.1",
  "description": "Medusa Product module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medusajs/medusa.git",
    "directory": "packages/modules/product"
  },
  "bugs": {
    "url": "https://github.com/medusajs/medusa/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Medusa",
  "license": "MIT",
  "scripts": {
    "watch": "tsc --build --watch",
    "watch:test": "tsc --build tsconfig.spec.json --watch",
    "resolve:aliases": "tsc --showConfig -p tsconfig.json > tsconfig.resolved.json && tsc-alias -p tsconfig.resolved.json && rimraf tsconfig.resolved.json",
    "build": "rimraf dist && tsc --build && pnpm run resolve:aliases",
    "test": "jest --bail --forceExit --testPathPattern=src",
    "test:integration": "jest --passWithNoTests --bail --forceExit --testPathPattern=\"integration-tests/__tests__/.*\\.spec\\.ts\"",
    "migration:initial": "MIKRO_ORM_CLI_CONFIG=./mikro-orm.config.dev.ts MIKRO_ORM_ALLOW_GLOBAL_CLI=true medusa-mikro-orm migration:create --initial",
    "migration:create": "MIKRO_ORM_CLI_CONFIG=./mikro-orm.config.dev.ts MIKRO_ORM_ALLOW_GLOBAL_CLI=true medusa-mikro-orm migration:create",
    "migration:up": "MIKRO_ORM_CLI_CONFIG=./mikro-orm.config.dev.ts MIKRO_ORM_ALLOW_GLOBAL_CLI=true medusa-mikro-orm migration:up",
    "orm:cache:clear": "MIKRO_ORM_CLI_CONFIG=./mikro-orm.config.dev.ts MIKRO_ORM_ALLOW_GLOBAL_CLI=true medusa-mikro-orm cache:clear"
  },
  "devDependencies": {
    "@nedusa/framework": "2.21.1",
    "@nedusa/test-utils": "2.21.1"
  },
  "peerDependencies": {
    "@nedusa/framework": "2.21.1"
  }
}
