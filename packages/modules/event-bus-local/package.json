  "description": "Local Event Bus Module for Medusa",
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "repository": {
    "type": "git",
