  },
  "bugs": {
    "url": "https://github.com/medusajs/medusa/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Medusa",
  "license": "MIT",
  "devDependencies": {
    "@nedusa/framework": "2.21.1"
  },
  "scripts": {
    "watch": "tsc --build --watch",
    "build": "rimraf dist && tsc --build",
    "test": "jest --passWithNoTests --testPathPattern=src",
    "test:integration": "jest --passWithNoTests --no-cache --bail --detectOpenHandles --forceExit --logHeapUsage --testPathPattern=\"integration-tests/__tests__/.*\\.spec\\.ts\""
  },
  "peerDependencies": {
    "@nedusa/framework": "2.21.1"
  }
